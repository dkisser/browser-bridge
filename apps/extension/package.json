{
  "name": "@browser-bridge/extension",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension for Browser Bridge",
  "scripts": {
    "dev": "bash scripts/dev-watch.sh",
    "build": "rm -rf dist && vite build && vite build --config vite.content.config.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@browser-bridge/bridge-core": "workspace:*",
    "@browser-bridge/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "typescript": "^5.4.0",
    "vite": "^5.3.0"
  }
}
