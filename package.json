{
  "name": "browser-bridge",
  "private": true,
  "version": "0.3.2",
  "description": "Bridge browser extensions and local services: Chrome extension (TS/Bun) + control plane and CLI (Go).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:core": "go -C apps/bridge-core run ./cmd/bridge serve",
    "dev:extension": "bun --cwd apps/extension dev",
    "build:extension": "bun --cwd apps/extension build",
    "build:cli": "mkdir -p dist && go -C apps/bridge-core build -o ../../dist/bridge ./cmd/bridge",
    "build:binaries": "bash .github/scripts/build-binaries.sh",
    "build:tarball": "bash .github/scripts/build-tarball.sh",
    "build:installer": "bash .github/scripts/build-installer.sh",
    "cli": "go -C apps/bridge-core run ./cmd/bridge",
    "fmt": "biome check --write . && gofmt -w apps/bridge-core",
    "lint": "biome check . && ! gofmt -l apps/bridge-core | grep . && go -C apps/bridge-core vet ./... && cd apps/bridge-core && golangci-lint run",
    "check": "bun run lint && bun run type-check && bun run test",
    "type-check": "tsc --noEmit",
    "test": "bun test && go -C apps/bridge-core test -race ./...",
    "test:watch": "bun test --watch",
    "test:install": "bats install/tests/",
    "release:extension-zip": "bash .github/scripts/build-extension-zip.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "latest",
    "typescript": "^5.4.0"
  }
}
