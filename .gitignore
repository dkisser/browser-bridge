node_modules/
dist/
*.log
.DS_Store
.superpowers/
.superpowers/
.worktrees/

# Local machine / agent configuration
.mcp.json
.agents/
.claude/

# Machine-local working directories, not part of Browser Bridge: .mavis/
# holds canvas assets and promo/ a separate video-production project (script,
# design specs, rendered assets). Both are untracked working state that
# `git add -A` would otherwise carry into whatever commit happens to be next.
# Anchored to the repo root so a same-named fixture under a subdirectory stays
# committable.
.mavis/
promo/

# Scratch dir for logo exploration. The mark that shipped lives in
# docs/assets/ as SVG (source of truth) + rendered PNGs; the generators and the
# comparison sheets here are how those were chosen and are not part of the
# product. Anchored to the repo root.
.logo-explore/

# Go build artifacts
apps/bridge-core/bridge-core
apps/bridge-core/bridge

# Release build artifacts. The .github/scripts/build-*.sh scripts default
# OUT_DIR to the repo root, so a local `bun run build:tarball` (or any of the
# release:* scripts) drops the built assets beside the source, where they sit
# as untracked noise that `git add -A` would cheerfully commit into the next
# commit. The release workflows upload these by path, so ignoring them here
# does not affect publishing.
#
# Anchored to the repo root so a same-named fixture under a subdirectory stays
# committable. The trailing `*` covers both the asset and its `.sha256`
# sidecar, and covers new architectures without another edit here.
/browser-bridge-*-v*
