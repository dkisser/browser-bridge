#!/usr/bin/env bash
# Browser Bridge CLI router. Browser commands are delegated to bridge-cmd;
# service lifecycle lives under `bridge service`. Emitted at install time —
# see install/install.sh write_artifacts() for substitution details.
#
# Bridge-core merge (ADR-0010): the pre-merge script supervised two processes
# (`ws-server` + `local-proxy`). After the merge there is one process —
# `bridge-core` — listening on three loopback ports (3001 control plane,
# 3002 extension, 3003 MCP). The supervisor and start/stop logic are
# rewritten to track a single child.
set -euo pipefail

BB_HOME="${BB_HOME:-$HOME/.browser-bridge}"
BB_EXTENSION_DIR="${BB_EXTENSION_DIR:-$HOME/Browser-Bridge}"
BRIDGE_VERSION="{{BRIDGE_VERSION}}"

WS_PORT="${BRIDGE_WS_PORT:-3001}"
WS_HOSTNAME="${BRIDGE_WS_HOSTNAME:-127.0.0.1}"
LOCAL_PORT="${BRIDGE_LOCAL_PORT:-3002}"
LOCAL_HOSTNAME="${BRIDGE_LOCAL_HOSTNAME:-127.0.0.1}"
MCP_PORT="${BRIDGE_MCP_PORT:-3003}"
MCP_HOSTNAME="${BRIDGE_MCP_HOSTNAME:-127.0.0.1}"
LOG_DIR="${BB_HOME:-$HOME/.browser-bridge}/logs"
RUN_DIR="${BB_HOME:-$HOME/.browser-bridge}/run"

LAUNCHAGENT_LABEL="com.browser-bridge.bridge"
STAGING_DIR="${BB_HOME:-$HOME/.browser-bridge}/launchagents"
SERVICE_NAME="bridge-core"

die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }

print_service_help() {
  cat <<'EOF'
Usage: bridge service <command> [args]

Commands:
  up [--foreground]   Start bridge-core (launchd-supervised on macOS)
  down                Stop bridge-core
  restart             Restart bridge-core
  status              Service state + login auto-start state
  logs                Tail logs (bridge-core)
  enable              Start bridge-core at login (macOS LaunchAgent)
  disable             Do not start bridge-core at login
  update [version]    Upgrade to a release (default: latest)
  doctor              Diagnose the install
  version             Print installed + latest version
  uninstall           Remove ~/.browser-bridge/ (use --yes to skip prompt)
EOF
}

print_help() {
  cat <<'EOF'
Usage: bridge <command> [args]

  bridge <command>          Control the browser (navigate, snapshot, ...)
  bridge service <command>  Manage services (up, down, status, enable, ...)

Service commands:
EOF
  print_service_help
  cat <<'EOF'

Browser commands:
EOF
  local cmd_bin="${BB_HOME:-$HOME/.browser-bridge}/bin/bridge-cmd"
  if [[ -x "$cmd_bin" ]]; then
    exec "$cmd_bin" --help
  fi
  cat <<'EOF'
  (bridge-cmd binary missing — reinstall Browser Bridge)
EOF
}

short_usage() {
  cat <<'EOF'
Usage: bridge <command> [args]

  bridge <command>          Control the browser (navigate, snapshot, ...)
  bridge service <command>  Manage services (up, down, status, enable, ...)

Run 'bridge --help' for the full list.
EOF
}

LATEST_VERSION="${LATEST_VERSION:-unknown}"

cmd_bridge_version() {
  echo "bridge ${BRIDGE_VERSION}"
}

cmd_service_version() {
  local installed
  installed=$(cat "$BB_HOME/version" 2>/dev/null || echo "unknown")
  printf 'installed: %s\nlatest:    %s\n' "$installed" "$LATEST_VERSION"
}

cmd_doctor() {
  local rc=0
  [[ -x "$BB_HOME/bin/bridge-core" ]] && echo "[OK] bridge-core binary present" || { echo "[FAIL] bridge-core binary missing"; rc=1; }
  [[ -x "$BB_HOME/bin/bridge-cmd" ]]  && echo "[OK] bridge-cmd binary present"  || { echo "[FAIL] bridge-cmd binary missing"; rc=1; }
  local ext_manifest="$BB_HOME/extension/manifest.json"
  local alt_manifest="$BB_EXTENSION_DIR/extension/manifest.json"
  if [[ -f "$ext_manifest" ]] && python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$ext_manifest" 2>/dev/null; then
    echo "[OK] extension/manifest.json valid"
  elif [[ -f "$alt_manifest" ]] && python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$alt_manifest" 2>/dev/null; then
    echo "[OK] extension/manifest.json valid (at $alt_manifest)"
  else
    echo "[FAIL] extension/manifest.json missing or invalid"; rc=1
  fi
  if service_state >/dev/null; then
    echo "[OK] bridge-core running"
  else
    echo "[WARN] bridge-core not running (run 'bridge service up')"
  fi
  return $rc
}

port_in_use() {
  local host="${2:-localhost}"
  python3 -c "
import socket, sys
try:
    s = socket.create_connection(('$host', int('$1')), timeout=1)
    s.close()
    sys.exit(0)
except (OSError, socket.timeout):
    sys.exit(1)
" 2>/dev/null
}

# bridge-core binds all three loopback ports (3001 control plane, 3002
# extension, 3003 MCP) and exits if any single bind fails. Conflict checks
# therefore have to cover the whole set: probing only the control plane lets a
# stale holder on 3002/3003 through to a bind failure that surfaces as a
# misleading BB-E011 on port 3001. Sets HELD_PORT to the port that is taken.
HELD_PORT=""
service_port_in_use() {
  local p
  for p in "$WS_PORT" "$LOCAL_PORT" "$MCP_PORT"; do
    if port_in_use "$p" 127.0.0.1; then
      HELD_PORT="$p"
      return 0
    fi
  done
  HELD_PORT=""
  return 1
}

# ---- Unsupervised (Linux / fallback) orchestration via pidfiles ----

start_service() {
  if [[ -f "$RUN_DIR/${SERVICE_NAME}.pid" ]] && kill -0 "$(cat "$RUN_DIR/${SERVICE_NAME}.pid")" 2>/dev/null; then
    info "$SERVICE_NAME already running (pid $(cat "$RUN_DIR/${SERVICE_NAME}.pid"))"
    return 0
  fi
  if service_port_in_use; then
    die "BB-E010: $SERVICE_NAME port $HELD_PORT is already in use"
  fi
  mkdir -p "$LOG_DIR" "$RUN_DIR"
  local logfile="$LOG_DIR/${SERVICE_NAME}.log" pidfile="$RUN_DIR/${SERVICE_NAME}.pid"
  BRIDGE_API_KEYS="${BRIDGE_API_KEYS:-}"
  env BB_HOME="$BB_HOME" \
      BRIDGE_WS_PORT="$WS_PORT" BRIDGE_WS_HOSTNAME="$WS_HOSTNAME" \
      BRIDGE_LOCAL_PORT="$LOCAL_PORT" BRIDGE_LOCAL_HOSTNAME="$LOCAL_HOSTNAME" \
      BRIDGE_MCP_PORT="$MCP_PORT" BRIDGE_MCP_HOSTNAME="$MCP_HOSTNAME" \
      BRIDGE_API_KEYS="$BRIDGE_API_KEYS" \
      "$BB_HOME/bin/bridge-core" >"$logfile" 2>&1 &
  pid=$!
  disown
  echo "$pid" >"$pidfile"
  # Liveness proxy only. bridge-core binds 3002, then 3001, then 3003, and
  # exits if any bind fails, so the control plane answering means the child
  # got that far. Probing the other two would add nothing: a port probe only
  # reports "something is listening", so a foreign holder on 3002/3003 reads
  # as healthy either way. Conflicts are caught by the pre-flight
  # service_port_in_use above, which is the check that can attribute a port to
  # the wrong process.
  for _ in {1..50}; do
    if ! port_in_use "$WS_PORT" "$WS_HOSTNAME"; then
      sleep 0.1
      continue
    fi
    return 0
  done
  kill "$(cat "$pidfile")" 2>/dev/null || true
  rm -f "$pidfile"
  die "BB-E011: $SERVICE_NAME failed to bind port $WS_PORT within 5s (see $logfile)"
}

stop_service() {
  local pidfile="$RUN_DIR/${SERVICE_NAME}.pid"
  [[ -f "$pidfile" ]] || { info "$SERVICE_NAME already stopped"; return 0; }
  local pid
  pid=$(cat "$pidfile")
  if ! pid_alive "$pid"; then
    info "$SERVICE_NAME: pid $pid not running, cleaning up"
    rm -f "$pidfile"
    return 0
  fi
  kill -TERM "$pid" 2>/dev/null || true
  for _ in {1..30}; do
    pid_alive "$pid" || break
    sleep 0.1
  done
  if pid_alive "$pid"; then
    kill -KILL "$pid" 2>/dev/null || true
    info "$SERVICE_NAME: sent SIGKILL after timeout"
  fi
  rm -f "$pidfile"
  info "$SERVICE_NAME stopped"
}

service_state() {
  local pidfile="$RUN_DIR/${SERVICE_NAME}.pid"
  if [[ -f "$pidfile" ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
    printf '%-13s running  (pid %s)\n' "$SERVICE_NAME:" "$(cat "$pidfile")"
    return 0
  fi
  printf '%-13s stopped\n' "$SERVICE_NAME:"
  return 1
}

cmd_logs() {
  local pyscript="$BB_HOME/.bridge-logs.py"
  cat > "$pyscript" <<'PYEOF'
import sys, subprocess, datetime, signal
files = sys.argv[1:]
proc = subprocess.Popen(['tail', '-f'] + files, stdout=subprocess.PIPE, text=True)
def cleanup(signum, frame):
    proc.terminate()
    try:
        proc.wait(timeout=2)
    except subprocess.TimeoutExpired:
        proc.kill()
    sys.exit(0)
signal.signal(signal.SIGTERM, cleanup)
signal.signal(signal.SIGINT, cleanup)
try:
    for line in proc.stdout:
        sys.stdout.write('%s %s' % (datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'), line))
        sys.stdout.flush()
except BrokenPipeError:
    cleanup(None, None)
PYEOF
  exec python3 -u "$pyscript" "$LOG_DIR/bridge-core.log"
}

cmd_service_update() {
  local target="${1:-latest}"
  local installer_url
  if [[ "$target" == "latest" ]]; then
    installer_url="https://github.com/{{ORG}}/{{REPO}}/releases/latest/download/install.sh"
  else
    installer_url="https://github.com/{{ORG}}/{{REPO}}/releases/download/${target}/install.sh"
  fi
  info "Updating to $target"
  BB_VERSION="$target" bash -c "$(curl -fsSL "$installer_url")" \
    || die "BB-E103: update failed"
  [[ -d "$BB_HOME" ]] && cmd_service_restart || true
}

# ---- macOS login auto-start (LaunchAgent) ----

is_macos() {
  [[ "$(uname -s)" == "Darwin" ]]
}

launchagent_path() {
  echo "$HOME/Library/LaunchAgents/${LAUNCHAGENT_LABEL}.plist"
}

staging_plist_path() {
  echo "${STAGING_DIR}/${LAUNCHAGENT_LABEL}.plist"
}

service_enabled() {
  [[ -f "$(launchagent_path)" ]]
}

launchagent_loaded() {
  launchctl list 2>/dev/null | awk '{print $3}' | grep -qx "$LAUNCHAGENT_LABEL"
}

# LaunchAgents live in the GUI session domain: launchd loads
# ~/Library/LaunchAgents jobs into "gui/$UID" at login, and current macOS
# rejects "user/$UID" (bootout: "No such process"; bootstrap: EIO). The
# user-domain fallback covers jobs an older release bootstrapped there. The
# last attempt keeps stderr attached so the real launchd error shows.
launchagent_bootout() {
  launchctl bootout "gui/$(id -u)/${LAUNCHAGENT_LABEL}" 2>/dev/null \
    || launchctl bootout "user/$(id -u)/${LAUNCHAGENT_LABEL}"
}

render_launchagent_plist() {
  local tmpl="$BB_HOME/launchagent.plist.tmpl"
  [[ -f "$tmpl" ]] || die "BB-E301: LaunchAgent template missing at $tmpl"
  # esc() XML-escapes plist-significant chars AND awk-escapes the replacement:
  # a bare & in a gsub replacement re-expands to the matched text, so each
  # entity is written \&amp; /\&lt; /\&gt; to stay literal on both levels.
  awk \
    -v bb_home="$BB_HOME" \
    -v ws_port="$WS_PORT" \
    -v ws_hostname="$WS_HOSTNAME" \
    -v local_port="$LOCAL_PORT" \
    -v local_hostname="$LOCAL_HOSTNAME" \
    -v mcp_port="$MCP_PORT" \
    -v mcp_hostname="$MCP_HOSTNAME" \
    '
    function esc(s) {
      gsub(/&/, "\\&amp;", s)
      gsub(/</, "\\&lt;", s)
      gsub(/>/, "\\&gt;", s)
      return s
    }
    { gsub(/{{BB_HOME}}/, esc(bb_home)); gsub(/{{WS_PORT}}/, esc(ws_port)); gsub(/{{WS_HOSTNAME}}/, esc(ws_hostname)); gsub(/{{LOCAL_PORT}}/, esc(local_port)); gsub(/{{LOCAL_HOSTNAME}}/, esc(local_hostname)); gsub(/{{MCP_PORT}}/, esc(mcp_port)); gsub(/{{MCP_HOSTNAME}}/, esc(mcp_hostname)); print }
  ' "$tmpl"
}

# Renders the plist to the staging dir (used by `service up` when auto-start
# is disabled) and, when enabled, to ~/Library/LaunchAgents (login bootstrap).
write_launchagent_plists() {
  is_macos || die "BB-E300: login auto-start is only supported on macOS"
  mkdir -p "$STAGING_DIR" "$HOME/Library/LaunchAgents"
  render_launchagent_plist > "$(staging_plist_path)"
  if service_enabled; then
    render_launchagent_plist > "$(launchagent_path)"
  fi
}

service_enable() {
  is_macos || die "BB-E300: login auto-start is only supported on macOS"
  mkdir -p "$HOME/Library/LaunchAgents"
  render_launchagent_plist > "$(launchagent_path)"
  info "Login auto-start enabled."
  launchagent_loaded || info "Services are not running yet ('bridge service up' starts them now)."
}

service_disable() {
  if ! is_macos; then
    info "Login auto-start: not supported on this platform (macOS only)."
    return 0
  fi
  rm -f "$(launchagent_path)" "$(staging_plist_path)"
  info "Login auto-start disabled. Running services are not stopped ('bridge service down' stops them)."
}

# ---- Supervisor: one foreground process holding bridge-core, so launchd can
# supervise it as a single KeepAlive'd job. The extension reconnects to a
# restarted bridge-core on its own (fixed 3s retry inside the extension).

pid_alive() {
  local pid="$1" st
  st=$(ps -p "$pid" -o state= 2>/dev/null) || st=""
  if [[ -z "$st" ]]; then
    # ps can come up empty for processes owned by other users (visibility);
    # kill -0 still tells us the pid exists, so don't report those as dead.
    if ! kill -0 "$pid" 2>/dev/null; then
      return 1
    fi
    return 0
  fi
  if [[ "$st" == "Z" ]]; then
    wait "$pid" 2>/dev/null || true
    return 1
  fi
  return 0
}

# Is pid really the thing we expect? Matches comm and the full command line,
# so it works for compiled binaries (comm = exe name) and for scripts (argv[0]
# carries the script path). Returns false when the pid is invisible.
pid_is() {
  local out
  out=$(ps -p "$1" -o comm=,args= 2>/dev/null) || return 1
  [[ -n "$out" && "$out" == *"$2"* ]]
}

supervisor_spawn() {
  local logfile="$LOG_DIR/${SERVICE_NAME}.log" pidfile="$RUN_DIR/${SERVICE_NAME}.pid"
  if [[ -f "$pidfile" ]] && pid_alive "$(cat "$pidfile")"; then
    info "supervisor: $SERVICE_NAME already running (pid $(cat "$pidfile"))"
    return 0
  fi
  if service_port_in_use; then
    die "BB-E010: $SERVICE_NAME port $HELD_PORT is already in use"
  fi
  BRIDGE_API_KEYS="${BRIDGE_API_KEYS:-}"
  # BB_HOME is passed on so StateManager resolves its config from the same
  # prefix install.sh used; launchd already sets it for the supervisor, this
  # is the hop that was missing.
  env BB_HOME="$BB_HOME" \
      BRIDGE_WS_PORT="$WS_PORT" BRIDGE_WS_HOSTNAME="$WS_HOSTNAME" \
      BRIDGE_LOCAL_PORT="$LOCAL_PORT" BRIDGE_LOCAL_HOSTNAME="$LOCAL_HOSTNAME" \
      BRIDGE_MCP_PORT="$MCP_PORT" BRIDGE_MCP_HOSTNAME="$MCP_HOSTNAME" \
      BRIDGE_API_KEYS="$BRIDGE_API_KEYS" \
      "$BB_HOME/bin/bridge-core" >"$logfile" 2>&1 &
  local pid=$!
  echo "$pid" >"$pidfile"
  # Same liveness proxy as start_service: the control plane binding is enough
  # to call the child up. Conflicts across all three ports were already ruled
  # out by the pre-flight check above.
  for _ in {1..50}; do
    if ! pid_alive "$pid"; then
      rm -f "$pidfile"
      die "BB-E011: $SERVICE_NAME exited before binding port $WS_PORT (see $logfile)"
    fi
    if port_in_use "$WS_PORT" "$WS_HOSTNAME"; then
      return 0
    fi
    sleep 0.1
  done
  kill "$pid" 2>/dev/null || true
  rm -f "$pidfile"
  die "BB-E011: $SERVICE_NAME failed to bind port $WS_PORT within 5s (see $logfile)"
}

# Classify one service for supervise(). Prints exactly one of:
#   ours <pid> — pidfile points at a live process that really is this service
#   free       — no live child of ours and the port is available
#   foreign    — the port is held without a trustworthy bridge pidfile
classify_service() {
  local pidfile="$RUN_DIR/${SERVICE_NAME}.pid" pid=""
  if [[ -f "$pidfile" ]]; then pid=$(cat "$pidfile" 2>/dev/null || true); fi
  if [[ -n "$pid" ]] && pid_alive "$pid"; then
    if pid_is "$pid" "$SERVICE_NAME"; then
      printf 'ours %s\n' "$pid"
      return 0
    fi
    if service_port_in_use; then
      printf 'foreign %s\n' "$HELD_PORT"
      return 0
    fi
    rm -f "$pidfile"
  else
    rm -f "$pidfile"
  fi
  if service_port_in_use; then
    printf 'foreign %s\n' "$HELD_PORT"
  else
    printf 'free\n'
  fi
}

supervisor_tick() {
  # Real 1s pause between polls. `read -t 1 < /dev/null` does NOT work here:
  # /dev/null gives immediate EOF, so read returns at once and the watch loop
  # would spin at 100% CPU. `sleep 1` still lets the TERM/INT trap run as soon
  # as the sleep finishes (~1s worst-case shutdown latency).
  sleep 1
}

supervisor_shutdown() {
  trap - TERM INT
  info "supervisor: shutting down"
  rm -f "$RUN_DIR/supervisor.pid"
  stop_service || true
  exit 0
}

supervisor_watch() {
  local restarts=0
  local pid pidfile dead
  while true; do
    pidfile="$RUN_DIR/${SERVICE_NAME}.pid"
    pid=""
    if [[ -f "$pidfile" ]]; then pid=$(cat "$pidfile"); fi
    if [[ -z "$pid" ]] || ! pid_alive "$pid"; then
      dead="1"
    else
      dead=""
    fi
    if [[ -z "$dead" ]]; then
      restarts=0
      supervisor_tick
      continue
    fi
    restarts=$((restarts + 1))
    if (( restarts > 5 )); then
      info "supervisor: $SERVICE_NAME keeps dying; giving up so launchd can restart the group"
      exit 1
    fi
    info "supervisor: restarting $SERVICE_NAME (attempt $restarts)"
    rm -f "$RUN_DIR/${SERVICE_NAME}.pid"
    supervisor_spawn
    supervisor_tick
  done
}

supervise() {
  [[ -x "$BB_HOME/bin/bridge-core" ]] || die "BB-E002: install not run. Execute the install script first."
  mkdir -p "$LOG_DIR" "$RUN_DIR"

  # Single-supervisor invariant: at most one supervisor may watch this RUN_DIR.
  if [[ -f "$RUN_DIR/supervisor.pid" ]]; then
    local spid
    spid=$(cat "$RUN_DIR/supervisor.pid" 2>/dev/null || true)
    if [[ -n "$spid" ]] && pid_is "$spid" 'service up --foreground'; then
      die "BB-E307: a supervisor is already running (pid $spid); not starting a second one"
    fi
    rm -f "$RUN_DIR/supervisor.pid"
  fi

  local state
  state=$(classify_service)
  if [[ "$state" == foreign* ]]; then
    local held="${state#foreign }"
    [[ -n "$held" ]] || held="$WS_PORT"
    die "BB-E010: port $held is held by a process with no trustworthy bridge pidfile; not taking over (launchd will retry)"
  fi

  echo $$ > "$RUN_DIR/supervisor.pid"
  trap 'supervisor_shutdown' TERM INT
  if [[ "$state" == ours* ]]; then
    info "supervisor: adopting $SERVICE_NAME (pid ${state#ours })"
  else
    supervisor_spawn
  fi
  info "supervisor: $SERVICE_NAME=$(cat "$RUN_DIR/${SERVICE_NAME}.pid")"
  supervisor_watch
}

cmd_service_up() {
  [[ -x "$BB_HOME/bin/bridge-core" ]] || die "BB-E002: install not run. Execute the install script first."
  if [[ "${1:-}" == "--foreground" ]]; then
    supervise
    return
  fi
  if ! is_macos; then
    start_service
    return
  fi
  if launchagent_loaded; then
    local spid=""
    if [[ -f "$RUN_DIR/supervisor.pid" ]]; then spid=$(cat "$RUN_DIR/supervisor.pid" 2>/dev/null || true); fi
    if [[ -n "$spid" ]] && pid_is "$spid" 'service up --foreground'; then
      info "bridge service up: already running (supervised by launchd, label ${LAUNCHAGENT_LABEL})"
      return 0
    fi
    launchagent_bootout || true
    info "bridge service up: replaced stale LaunchAgent job (label ${LAUNCHAGENT_LABEL})"
  fi
  local state
  state=$(classify_service)
  # classify_service reports the port it found held ("foreign <port>"), so the
  # match has to be a prefix — a bare `== foreign` never fires and launchd then
  # restarts a supervisor that dies BB-E010 on every start.
  if [[ "$state" == foreign* ]]; then
    local held="${state#foreign }"
    [[ -n "$held" ]] || held="$WS_PORT"
    die "BB-E010: port $held is occupied by something other than a supervised bridge instance (check 'bridge service status'). Free the port and retry."
  fi
  write_launchagent_plists
  local plist
  if service_enabled; then
    plist=$(launchagent_path)
  else
    plist=$(staging_plist_path)
  fi
  launchctl bootstrap "gui/$(id -u)" "$plist" \
    || die "BB-E302: failed to load LaunchAgent with launchctl bootstrap"
  info "bridge service up: supervisor started (label ${LAUNCHAGENT_LABEL})"
}

cmd_service_down() {
  if is_macos; then
    if launchagent_loaded; then
      launchagent_bootout \
        || die "BB-E304: failed to stop the supervisor (launchctl bootout failed)"
      info "supervisor stopped"
      # The supervisor's trap stops the children; give it a moment before the
      # sweep below so we don't double-signal them.
      sleep 1
    else
      info "supervisor not loaded"
    fi
    if [[ -f "$RUN_DIR/${SERVICE_NAME}.pid" ]]; then stop_service; fi
    rm -f "$RUN_DIR/supervisor.pid"
  else
    stop_service
  fi
}

cmd_service_restart() {
  cmd_service_down
  cmd_service_up
}

cmd_service_status() {
  local rc=0
  service_state || rc=1
  if is_macos; then
    if service_enabled; then
      if launchagent_loaded; then
        info "auto-start:  enabled, agent loaded (label ${LAUNCHAGENT_LABEL})"
      else
        info "auto-start:  enabled (starts at login; not running now)"
      fi
    else
      info "auto-start:  disabled"
    fi
  else
    info "auto-start:  unsupported on this platform (macOS only)"
  fi
  return $rc
}

cmd_service_uninstall() {
  local yes=false
  [[ "${1:-}" == "--yes" ]] && yes=true
  if ! $yes; then
    read -rp "About to rm -rf $BB_HOME. Continue? [y/N] " ans
    [[ "$ans" == "y" || "$ans" == "Y" ]] || { echo "aborted"; return 0; }
  fi
  service_disable
  cmd_service_down || true
  rm -rf "$BB_HOME"
  echo "Removed $BB_HOME"
  if [[ -d "$BB_EXTENSION_DIR" ]]; then
    rm -rf "$BB_EXTENSION_DIR"
    echo "Removed $BB_EXTENSION_DIR"
  fi
  if [[ -L "$HOME/.local/bin/bridge" ]] && [[ ! -e "$HOME/.local/bin/bridge" ]]; then
    rm -f "$HOME/.local/bin/bridge"
    echo "Removed stale symlink $HOME/.local/bin/bridge"
  fi
}

cmd_service() {
  if [[ $# -eq 0 ]]; then
    print_service_help
    return 0
  fi
  local sub="$1"
  shift
  case "$sub" in
    up)        cmd_service_up "$@" ;;
    down)      cmd_service_down ;;
    restart)   cmd_service_restart ;;
    status)    cmd_service_status ;;
    logs)      cmd_logs "$@" ;;
    enable)    service_enable ;;
    disable)   service_disable ;;
    update)    cmd_service_update "$@" ;;
    doctor)    cmd_doctor ;;
    version)   cmd_service_version ;;
    uninstall) cmd_service_uninstall "$@" ;;
    *) die "BB-E306: unknown service command '$sub'. Run 'bridge service' for the list." ;;
  esac
}

# Deprecated: `bridge autostart on|off|status` (pre-service-namespace).
# Kept for one release; maps onto the service commands.
cmd_autostart_deprecated() {
  local action="${1:-status}"
  printf '%s\n' "Deprecation warning: 'bridge autostart' is deprecated; use 'bridge service enable|disable' (state: 'bridge service status')." >&2
  case "$action" in
    on)      service_enable; cmd_service_up ;;
    off)     cmd_service_down; service_disable ;;
    status)  cmd_service_status ;;
    *) die "BB-E303: usage: bridge autostart on|off|status (deprecated)" ;;
  esac
}

main() {
  if [[ $# -eq 0 ]]; then
    short_usage
    exit 0
  fi
  case "$1" in
    --version|-V) cmd_bridge_version; exit 0 ;;
    -h|--help|help) print_help; exit 0 ;;
    service) shift; cmd_service "$@" ;;
    autostart) shift; cmd_autostart_deprecated "$@" ;;
    up|down|restart|status|logs|update|doctor|uninstall|version)
      die "BB-E305: '$1' has moved: lifecycle commands live under 'bridge service' — try 'bridge service $1'." ;;
    *)
      local cmd_bin="${BB_HOME:-$HOME/.browser-bridge}/bin/bridge-cmd"
      if [[ -x "$cmd_bin" ]]; then
        exec "$cmd_bin" "$@"
      fi
      die "BB-E101: unknown command '$1'. Run 'bridge --help' for help." ;;
  esac
}

# Only run main when the script is executed, not when sourced for tests.
if [[ "${BASH_SOURCE[0]:-$0}" == "$0" ]]; then
  main "$@"
fi
