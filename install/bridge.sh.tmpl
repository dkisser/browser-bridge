#!/usr/bin/env bash
# Browser Bridge CLI router. Browser commands are delegated to bridge-cmd;
# service lifecycle lives under `bridge service`. Emitted at install time —
# see install/install.sh write_artifacts() for substitution details.
set -euo pipefail

BB_HOME="${BB_HOME:-$HOME/.browser-bridge}"
BB_EXTENSION_DIR="${BB_EXTENSION_DIR:-$HOME/Browser-Bridge}"
BRIDGE_VERSION="{{BRIDGE_VERSION}}"

WS_PORT="${BRIDGE_WS_PORT:-3001}"
WS_HOSTNAME="${BRIDGE_WS_HOSTNAME:-127.0.0.1}"
LOCAL_PROXY_PORT="${BRIDGE_LOCAL_PROXY_PORT:-3002}"
LOCAL_PROXY_HOSTNAME="${BRIDGE_LOCAL_HOSTNAME:-127.0.0.1}"
LOG_DIR="${BB_HOME:-$HOME/.browser-bridge}/logs"
RUN_DIR="${BB_HOME:-$HOME/.browser-bridge}/run"

LAUNCHAGENT_LABEL="com.browser-bridge.bridge"
STAGING_DIR="${BB_HOME:-$HOME/.browser-bridge}/launchagents"

die() { printf 'Error: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }

print_service_help() {
  cat <<'EOF'
Usage: bridge service <command> [args]

Commands:
  up [--foreground]   Start ws-server and local-proxy (launchd-supervised on macOS)
  down                Stop both services
  restart             Restart services
  status              Service state + login auto-start state
  logs [name]         Tail logs (ws-server | local-proxy)
  enable              Start services at login (macOS LaunchAgent)
  disable             Do not start services at login
  update [version]    Upgrade to a release (default: latest)
  doctor              Diagnose the install
  version             Print installed + latest version
  uninstall           Remove ~/.browser-bridge/ (use --yes to skip prompt)
EOF
}

print_help() {
  cat <<'EOF'
Usage: bridge <command> [args]

  bridge <command>          Control the browser (navigate, snapshot, ...)
  bridge service <command>  Manage services (up, down, status, enable, ...)

Service commands:
EOF
  print_service_help
  cat <<'EOF'

Browser commands:
EOF
  local cmd_bin="${BB_HOME:-$HOME/.browser-bridge}/bin/bridge-cmd"
  if [[ -x "$cmd_bin" ]]; then
    exec "$cmd_bin" --help
  fi
  cat <<'EOF'
  (bridge-cmd binary missing — reinstall Browser Bridge)
EOF
}

short_usage() {
  cat <<'EOF'
Usage: bridge <command> [args]

  bridge <command>          Control the browser (navigate, snapshot, ...)
  bridge service <command>  Manage services (up, down, status, enable, ...)

Run 'bridge --help' for the full list.
EOF
}

LATEST_VERSION="${LATEST_VERSION:-unknown}"

cmd_bridge_version() {
  echo "bridge ${BRIDGE_VERSION}"
}

cmd_service_version() {
  local installed
  installed=$(cat "$BB_HOME/version" 2>/dev/null || echo "unknown")
  printf 'installed: %s\nlatest:    %s\n' "$installed" "$LATEST_VERSION"
}

cmd_doctor() {
  local rc=0
  [[ -x "$BB_HOME/bin/ws-server" ]]   && echo "[OK] ws-server binary present"   || { echo "[FAIL] ws-server binary missing"; rc=1; }
  [[ -x "$BB_HOME/bin/local-proxy" ]] && echo "[OK] local-proxy binary present" || { echo "[FAIL] local-proxy binary missing"; rc=1; }
  [[ -x "$BB_HOME/bin/bridge-cmd" ]]  && echo "[OK] bridge-cmd binary present"  || { echo "[FAIL] bridge-cmd binary missing"; rc=1; }
  local ext_manifest="$BB_HOME/extension/manifest.json"
  local alt_manifest="$BB_EXTENSION_DIR/extension/manifest.json"
  if [[ -f "$ext_manifest" ]] && python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$ext_manifest" 2>/dev/null; then
    echo "[OK] extension/manifest.json valid"
  elif [[ -f "$alt_manifest" ]] && python3 -c "import json,sys; json.load(open(sys.argv[1]))" "$alt_manifest" 2>/dev/null; then
    echo "[OK] extension/manifest.json valid (at $alt_manifest)"
  else
    echo "[FAIL] extension/manifest.json missing or invalid"; rc=1
  fi
  if service_state ws-server >/dev/null && service_state local-proxy >/dev/null; then
    echo "[OK] both services running"
  else
    echo "[WARN] one or more services not running (run 'bridge service up')"
  fi
  return $rc
}

port_in_use() {
  python3 -c "
import socket, sys
try:
    s = socket.create_connection(('localhost', int('$1')), timeout=1)
    s.close()
    sys.exit(0)
except (OSError, socket.timeout):
    sys.exit(1)
" 2>/dev/null
}

# ---- Unsupervised (Linux / fallback) orchestration via pidfiles ----

start_service() {
  local name="$1" binary="$2" port="$3"
  local logfile="$LOG_DIR/${name}.log" pidfile="$RUN_DIR/${name}.pid"
  if [[ -f "$pidfile" ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
    info "$name already running (pid $(cat "$pidfile"))"
    return 0
  fi
  if port_in_use "$port"; then
    die "BB-E010: $name port $port is already in use"
  fi
  ( exec "$binary" >"$logfile" 2>&1 ) & pid=$!
  disown
  echo "$pid" >"$pidfile"
  for _ in {1..50}; do
    if ! port_in_use "$port"; then
      sleep 0.1
      continue
    fi
    return 0
  done
  kill "$(cat "$pidfile")" 2>/dev/null || true
  rm -f "$pidfile"
  die "BB-E011: $name failed to bind port $port within 5s (see $logfile)"
}

legacy_up() {
  [[ -x "$BB_HOME/bin/ws-server" ]] || die "BB-E002: install not run. Execute the install script first."
  [[ -x "$BB_HOME/bin/local-proxy" ]] || die "BB-E002: install not run. Execute the install script first."
  mkdir -p "$LOG_DIR" "$RUN_DIR"
  BRIDGE_WS_PORT="$WS_PORT" BRIDGE_WS_HOSTNAME="$WS_HOSTNAME" start_service ws-server "$BB_HOME/bin/ws-server" "$WS_PORT"
  BRIDGE_LOCAL_PORT="$LOCAL_PROXY_PORT" BRIDGE_LOCAL_HOSTNAME="$LOCAL_PROXY_HOSTNAME" BRIDGE_LOCAL_PROXY_PORT="$LOCAL_PROXY_PORT" BRIDGE_WS_URL="ws://127.0.0.1:$WS_PORT" start_service local-proxy "$BB_HOME/bin/local-proxy" "$LOCAL_PROXY_PORT"
  info "bridge service up: ws-server=$(cat "$RUN_DIR/ws-server.pid"), local-proxy=$(cat "$RUN_DIR/local-proxy.pid")"
}

stop_service() {
  local name="$1"
  local pidfile="$RUN_DIR/${name}.pid"
  [[ -f "$pidfile" ]] || { info "$name already stopped"; return 0; }
  local pid
  pid=$(cat "$pidfile")
  if ! pid_alive "$pid"; then
    info "$name: pid $pid not running, cleaning up"
    rm -f "$pidfile"
    return 0
  fi
  kill -TERM "$pid" 2>/dev/null || true
  for _ in {1..30}; do
    pid_alive "$pid" || break
    sleep 0.1
  done
  if pid_alive "$pid"; then
    kill -KILL "$pid" 2>/dev/null || true
    info "$name: sent SIGKILL after timeout"
  fi
  rm -f "$pidfile"
  info "$name stopped"
}

legacy_down() {
  stop_service ws-server
  stop_service local-proxy
}

service_state() {
  local name="$1"
  local pidfile="$RUN_DIR/${name}.pid"
  if [[ -f "$pidfile" ]] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then
    printf '%-13s running  (pid %s)\n' "$name:" "$(cat "$pidfile")"
    return 0
  fi
  printf '%-13s stopped\n' "$name:"
  return 1
}

cmd_logs() {
  local name="${1:-}"
  local pyscript="$BB_HOME/.bridge-logs.py"
  cat > "$pyscript" <<'PYEOF'
import sys, subprocess, datetime, signal
files = sys.argv[1:]
proc = subprocess.Popen(['tail', '-f'] + files, stdout=subprocess.PIPE, text=True)
def cleanup(signum, frame):
    proc.terminate()
    try:
        proc.wait(timeout=2)
    except subprocess.TimeoutExpired:
        proc.kill()
    sys.exit(0)
signal.signal(signal.SIGTERM, cleanup)
signal.signal(signal.SIGINT, cleanup)
try:
    for line in proc.stdout:
        sys.stdout.write('%s %s' % (datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S'), line))
        sys.stdout.flush()
except BrokenPipeError:
    cleanup(None, None)
PYEOF
  case "$name" in
    ws-server|local-proxy) exec python3 -u "$pyscript" "$LOG_DIR/${name}.log" ;;
    "")                    exec python3 -u "$pyscript" "$LOG_DIR/ws-server.log" "$LOG_DIR/local-proxy.log" ;;
    *) die "BB-E102: unknown log target '$name' (use ws-server | local-proxy)" ;;
  esac
}

cmd_service_update() {
  local target="${1:-latest}"
  local installer_url
  if [[ "$target" == "latest" ]]; then
    installer_url="https://github.com/{{ORG}}/{{REPO}}/releases/latest/download/install.sh"
  else
    installer_url="https://github.com/{{ORG}}/{{REPO}}/releases/download/${target}/install.sh"
  fi
  info "Updating to $target"
  BB_VERSION="$target" bash -c "$(curl -fsSL "$installer_url")" \
    || die "BB-E103: update failed"
  [[ -d "$BB_HOME" ]] && cmd_service_restart || true
}

# ---- macOS login auto-start (LaunchAgent) ----

is_macos() {
  [[ "$(uname -s)" == "Darwin" ]]
}

launchagent_path() {
  echo "$HOME/Library/LaunchAgents/${LAUNCHAGENT_LABEL}.plist"
}

staging_plist_path() {
  echo "${STAGING_DIR}/${LAUNCHAGENT_LABEL}.plist"
}

service_enabled() {
  [[ -f "$(launchagent_path)" ]]
}

launchagent_loaded() {
  launchctl list 2>/dev/null | awk '{print $3}' | grep -qx "$LAUNCHAGENT_LABEL"
}

render_launchagent_plist() {
  local tmpl="$BB_HOME/launchagent.plist.tmpl"
  [[ -f "$tmpl" ]] || die "BB-E301: LaunchAgent template missing at $tmpl"
  awk \
    -v bb_home="$BB_HOME" \
    -v ws_port="$WS_PORT" \
    -v ws_hostname="$WS_HOSTNAME" \
    -v local_proxy_port="$LOCAL_PROXY_PORT" \
    -v local_proxy_hostname="$LOCAL_PROXY_HOSTNAME" '
    { gsub(/{{BB_HOME}}/, bb_home); gsub(/{{WS_PORT}}/, ws_port); gsub(/{{WS_HOSTNAME}}/, ws_hostname); gsub(/{{LOCAL_PROXY_PORT}}/, local_proxy_port); gsub(/{{LOCAL_PROXY_HOSTNAME}}/, local_proxy_hostname); print }
  ' "$tmpl"
}

# Renders the plist to the staging dir (used by `service up` when auto-start
# is disabled) and, when enabled, to ~/Library/LaunchAgents (login bootstrap).
write_launchagent_plists() {
  is_macos || die "BB-E300: login auto-start is only supported on macOS"
  mkdir -p "$STAGING_DIR" "$HOME/Library/LaunchAgents"
  render_launchagent_plist > "$(staging_plist_path)"
  if service_enabled; then
    render_launchagent_plist > "$(launchagent_path)"
  fi
}

service_enable() {
  is_macos || die "BB-E300: login auto-start is only supported on macOS"
  mkdir -p "$HOME/Library/LaunchAgents"
  render_launchagent_plist > "$(launchagent_path)"
  info "Login auto-start enabled."
  launchagent_loaded || info "Services are not running yet ('bridge service up' starts them now)."
}

service_disable() {
  if ! is_macos; then
    info "Login auto-start: not supported on this platform (macOS only)."
    return 0
  fi
  rm -f "$(launchagent_path)"
  info "Login auto-start disabled. Running services are not stopped ('bridge service down' stops them)."
}

# ---- Supervisor: one foreground process holding both services, so launchd
# can supervise the group as a single KeepAlive'd job. Only the child that
# died is restarted; local-proxy and the extension reconnect to a restarted
# ws-server on their own.

pid_alive() {
  local pid="$1" st
  st=$(ps -p "$pid" -o state= 2>/dev/null) || return 1
  if [[ "$st" == "Z" ]]; then
    wait "$pid" 2>/dev/null || true
    return 1
  fi
  return 0
}

supervisor_spawn() {
  local name="$1" binary="$2" port="$3"
  local logfile="$LOG_DIR/${name}.log" pidfile="$RUN_DIR/${name}.pid"
  if [[ -f "$pidfile" ]] && pid_alive "$(cat "$pidfile")"; then
    info "supervisor: $name already running (pid $(cat "$pidfile"))"
    return 0
  fi
  if port_in_use "$port"; then
    die "BB-E010: $name port $port is already in use"
  fi
  ( exec "$binary" >"$logfile" 2>&1 ) &
  local pid=$!
  echo "$pid" >"$pidfile"
  for _ in {1..50}; do
    if ! pid_alive "$pid"; then
      rm -f "$pidfile"
      die "BB-E011: $name exited before binding port $port (see $logfile)"
    fi
    if port_in_use "$port"; then
      return 0
    fi
    sleep 0.1
  done
  kill "$pid" 2>/dev/null || true
  rm -f "$pidfile"
  die "BB-E011: $name failed to bind port $port within 5s (see $logfile)"
}

supervisor_start_ws() {
  BRIDGE_WS_PORT="$WS_PORT" BRIDGE_WS_HOSTNAME="$WS_HOSTNAME" \
    supervisor_spawn ws-server "$BB_HOME/bin/ws-server" "$WS_PORT"
}

supervisor_start_proxy() {
  BRIDGE_LOCAL_PORT="$LOCAL_PROXY_PORT" BRIDGE_LOCAL_HOSTNAME="$LOCAL_PROXY_HOSTNAME" \
    BRIDGE_LOCAL_PROXY_PORT="$LOCAL_PROXY_PORT" BRIDGE_WS_URL="ws://127.0.0.1:$WS_PORT" \
    supervisor_spawn local-proxy "$BB_HOME/bin/local-proxy" "$LOCAL_PROXY_PORT"
}

supervisor_tick() {
  read -r -t 1 < /dev/null || true
}

supervisor_shutdown() {
  trap - TERM INT
  info "supervisor: shutting down"
  stop_service ws-server || true
  stop_service local-proxy || true
  exit 0
}

supervisor_watch() {
  local restarts=0
  local name pid pidfile dead
  while true; do
    dead=""
    for name in ws-server local-proxy; do
      pidfile="$RUN_DIR/${name}.pid"
      pid=""
      [[ -f "$pidfile" ]] && pid=$(cat "$pidfile")
      if [[ -z "$pid" ]] || ! pid_alive "$pid"; then
        dead="$name"
        break
      fi
    done
    if [[ -z "$dead" ]]; then
      restarts=0
      supervisor_tick
      continue
    fi
    restarts=$((restarts + 1))
    if (( restarts > 5 )); then
      info "supervisor: $dead keeps dying; giving up so launchd can restart the group"
      exit 1
    fi
    info "supervisor: restarting $dead (attempt $restarts)"
    rm -f "$RUN_DIR/${dead}.pid"
    case "$dead" in
      ws-server)   supervisor_start_ws ;;
      local-proxy) supervisor_start_proxy ;;
    esac
    supervisor_tick
  done
}

supervise() {
  [[ -x "$BB_HOME/bin/ws-server" ]] || die "BB-E002: install not run. Execute the install script first."
  [[ -x "$BB_HOME/bin/local-proxy" ]] || die "BB-E002: install not run. Execute the install script first."
  mkdir -p "$LOG_DIR" "$RUN_DIR"
  # Idempotent up: a healthy pair started by other means (e.g. an older
  # unsupervised instance) is left alone; launchd sees a clean exit.
  if port_in_use "$WS_PORT" && port_in_use "$LOCAL_PROXY_PORT"; then
    info "supervisor: ports $WS_PORT/$LOCAL_PROXY_PORT already served; nothing to do"
    exit 0
  fi
  trap 'supervisor_shutdown' TERM INT
  supervisor_start_ws
  supervisor_start_proxy
  info "supervisor: ws-server=$(cat "$RUN_DIR/ws-server.pid"), local-proxy=$(cat "$RUN_DIR/local-proxy.pid")"
  supervisor_watch
}

cmd_service_up() {
  [[ -x "$BB_HOME/bin/ws-server" ]] || die "BB-E002: install not run. Execute the install script first."
  [[ -x "$BB_HOME/bin/local-proxy" ]] || die "BB-E002: install not run. Execute the install script first."
  if [[ "${1:-}" == "--foreground" ]]; then
    supervise
    return
  fi
  if ! is_macos; then
    legacy_up
    return
  fi
  if launchagent_loaded; then
    info "bridge service up: already running (supervised by launchd, label ${LAUNCHAGENT_LABEL})"
    return 0
  fi
  if port_in_use "$WS_PORT" || port_in_use "$LOCAL_PROXY_PORT"; then
    die "BB-E010: port $WS_PORT or $LOCAL_PROXY_PORT is occupied by something other than a supervised bridge instance (check 'bridge service status'). Free the port and retry."
  fi
  write_launchagent_plists
  local plist
  if service_enabled; then
    plist=$(launchagent_path)
  else
    plist=$(staging_plist_path)
  fi
  launchctl bootstrap "user/$(id -u)" "$plist" \
    || die "BB-E302: failed to load LaunchAgent with launchctl bootstrap"
  info "bridge service up: supervisor started (label ${LAUNCHAGENT_LABEL})"
}

cmd_service_down() {
  if is_macos; then
    if launchagent_loaded; then
      launchctl bootout "user/$(id -u)/${LAUNCHAGENT_LABEL}" 2>/dev/null \
        || die "BB-E304: failed to stop the supervisor (launchctl bootout failed)"
      info "supervisor stopped"
    else
      info "supervisor not loaded"
    fi
  fi
  # Also clean up unsupervised (legacy/Linux) instances.
  stop_service ws-server
  stop_service local-proxy
}

cmd_service_restart() {
  cmd_service_down
  cmd_service_up
}

cmd_service_status() {
  local rc=0
  service_state ws-server || rc=1
  service_state local-proxy || rc=1
  if is_macos; then
    if service_enabled; then
      if launchagent_loaded; then
        info "auto-start:  enabled, agent loaded (label ${LAUNCHAGENT_LABEL})"
      else
        info "auto-start:  enabled (starts at login; not running now)"
      fi
    else
      info "auto-start:  disabled"
    fi
  else
    info "auto-start:  unsupported on this platform (macOS only)"
  fi
  return $rc
}

cmd_service_uninstall() {
  local yes=false
  [[ "${1:-}" == "--yes" ]] && yes=true
  if ! $yes; then
    read -rp "About to rm -rf $BB_HOME. Continue? [y/N] " ans
    [[ "$ans" == "y" || "$ans" == "Y" ]] || { echo "aborted"; return 0; }
  fi
  service_disable
  cmd_service_down || true
  rm -rf "$BB_HOME"
  echo "Removed $BB_HOME"
  if [[ -d "$BB_EXTENSION_DIR" ]]; then
    rm -rf "$BB_EXTENSION_DIR"
    echo "Removed $BB_EXTENSION_DIR"
  fi
  if [[ -L "$HOME/.local/bin/bridge" ]] && [[ ! -e "$HOME/.local/bin/bridge" ]]; then
    rm -f "$HOME/.local/bin/bridge"
    echo "Removed stale symlink $HOME/.local/bin/bridge"
  fi
}

cmd_service() {
  if [[ $# -eq 0 ]]; then
    print_service_help
    return 0
  fi
  local sub="$1"
  shift
  case "$sub" in
    up)        cmd_service_up "$@" ;;
    down)      cmd_service_down ;;
    restart)   cmd_service_restart ;;
    status)    cmd_service_status ;;
    logs)      cmd_logs "$@" ;;
    enable)    service_enable ;;
    disable)   service_disable ;;
    update)    cmd_service_update "$@" ;;
    doctor)    cmd_doctor ;;
    version)   cmd_service_version ;;
    uninstall) cmd_service_uninstall "$@" ;;
    *) die "BB-E306: unknown service command '$sub'. Run 'bridge service' for the list." ;;
  esac
}

# Deprecated: `bridge autostart on|off|status` (pre-service-namespace).
# Kept for one release; maps onto the service commands.
cmd_autostart_deprecated() {
  local action="${1:-status}"
  printf '%s\n' "Deprecation warning: 'bridge autostart' is deprecated; use 'bridge service enable|disable' (state: 'bridge service status')." >&2
  case "$action" in
    on)      service_enable; cmd_service_up ;;
    off)     cmd_service_down; service_disable ;;
    status)  cmd_service_status ;;
    *) die "BB-E303: usage: bridge autostart on|off|status (deprecated)" ;;
  esac
}

main() {
  if [[ $# -eq 0 ]]; then
    short_usage
    exit 0
  fi
  case "$1" in
    --version|-V) cmd_bridge_version; exit 0 ;;
    -h|--help|help) print_help; exit 0 ;;
    service) shift; cmd_service "$@" ;;
    autostart) shift; cmd_autostart_deprecated "$@" ;;
    up|down|restart|status|logs|update|doctor|uninstall|version)
      die "BB-E305: '$1' has moved: lifecycle commands live under 'bridge service' — try 'bridge service $1'." ;;
    *)
      local cmd_bin="${BB_HOME:-$HOME/.browser-bridge}/bin/bridge-cmd"
      if [[ -x "$cmd_bin" ]]; then
        exec "$cmd_bin" "$@"
      fi
      die "BB-E101: unknown command '$1'. Run 'bridge --help' for help." ;;
  esac
}

# Only run main when the script is executed, not when sourced for tests.
if [[ "${BASH_SOURCE[0]:-$0}" == "$0" ]]; then
  main "$@"
fi
